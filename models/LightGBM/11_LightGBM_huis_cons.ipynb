    "def gem_venster(eind, lengte):\n",
    "    \"\"\"Gemiddelde van de bekende waarden in y[eind-lengte : eind] (NaN als er geen bekend is).\"\"\"\n",
    "    aantal = cumaantal[eind] - cumaantal[eind - lengte]\n",
    "    som = cumsum[eind] - cumsum[eind - lengte]\n",
    "    return np.where(aantal > 0, som / np.maximum(aantal, 1), np.nan)\n",
    "\n",
    "\n",
    "def bouw_rijen(origins):\n",
    "    origins = np.asarray(origins)\n",
    "    h = np.tile(np.arange(horizon), len(origins))\n",
    "    o = np.repeat(origins, horizon)\n",
    "    t = o + h                                        # index van het voorspelde tijdstip\n",
    "    k = h // stap_per_dag + 1                        # aantal dagen terug zodat het tijdstip al bekend is\n",
    "\n",
    "    # zelfde tijdstip op de 7 meest recente bekende dagen, gemiddeld over de dagen met een waarde\n",
    "    dagen7 = np.stack([y_arr[t - stap_per_dag * (k + j)] for j in range(7)])\n",
    "    aantal7 = (~np.isnan(dagen7)).sum(axis=0)\n",
    "    gem7 = np.where(aantal7 > 0, np.nansum(dagen7, axis=0) / np.maximum(aantal7, 1), np.nan)\n",
    "\n",
    "    X = {\n",
    "        \"stap\": h.astype(np.float32),\n",
    "        \"dag_vooruit\": (k - 1).astype(np.float32),\n",
    "        \"laatste\": y_laatst_bekend[o - 1],\n",
    "        \"gem_1u\": gem_venster(o, 12),\n",
    "        \"gem_24u\": gem_venster(o, stap_per_dag),\n",
    "        \"gem_7d\": gem_venster(o, input_len),\n",
    "        \"zelfde_tijd_recent\": dagen7[0],\n",
    "        \"zelfde_tijd_gem7\": gem7,\n",
    "        \"zelfde_tijd_vorige_week\": y_arr[t - input_len],\n",
    "        \"zelfde_tijd_vorige_week_gem1u\": gem_venster(np.minimum(t - input_len + 6, o), 12),\n",
    "        \"straling_24u\": straling_24u_arr[o - 1],\n",
    "    }\n",
    "    X = pd.DataFrame(X).astype(np.float32)\n",
    "    X[TIJD_COLS] = tijd_arr[t]\n",
    "    if GEBRUIK_TOEKOMST_WEER:\n",
    "        X[WEER_COLS] = weer_arr[t]                   # weer op het voorspelde tijdstip\n",
    "    else:\n",
    "        X[WEER_COLS] = weer_arr[o - 1]               # laatst bekende weer\n",
    "    return X, y_arr[t]\n",
    "\n",
    "\n",
    "def bouw_trainset(origins):\n",
    "    \"\"\"Rijen bouwen en de rijen zonder doelwaarde laten vallen.\"\"\"\n",
    "    X, y = bouw_rijen(origins)\n",
    "    heeft_doel = ~np.isnan(y)\n",
    "    return X[heeft_doel].reset_index(drop=True), y[heeft_doel]\n",
    "\n",
    "\n",
    "# train: historie en horizon volledig in train\n",
    "train_origins = ev.train_origins(huis_cons, input_len=input_len, horizon=horizon, stap=stride_train, volledig=False)\n",
    "# validatie en test: vaste momenten binnen de vensters, voor elk model hetzelfde\n",
    "val_origins = ev.maak_origins(huis_cons, \"val\", stap=stride_eval, horizon=horizon)\n",
    "test_origins = ev.maak_origins(huis_cons, \"test\", stap=stride_eval, horizon=horizon)\n",
    "\n",
    "t0 = time.perf_counter()\n",
    "X_train, y_train = bouw_trainset(train_origins)\n",
    "X_val, y_val = bouw_trainset(val_origins)\n",
    "runtimes[\"features bouwen\"] = time.perf_counter() - t0\n",
    "\n",
