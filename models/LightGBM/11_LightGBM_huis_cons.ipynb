    "def rolling_validatie(begin, eind, step_size=stap_per_dag):\n",
    "    origins = begin + input_len + np.arange(0, (eind - begin) - input_len - horizon + 1, step_size)\n",
    "    pred, echt, _ = voorspel(origins)\n",
    "    maes = np.abs(pred - echt).mean(axis=1)\n",
    "    rmses = np.sqrt(((pred - echt) ** 2).mean(axis=1))\n",
    "    return len(origins), maes, rmses\n",
    "\n",
    "for naam, (begin, eind) in {\"validatie\": (i_train, i_val), \"test\": (i_val, n)}.items():\n",
    "    aantal, maes, rmses = rolling_validatie(begin, eind)\n",
    "    print(f\"{naam:10s} | {aantal} rolling windows | MAE: {maes.mean():.2f} W | RMSE: {rmses.mean():.2f} W\")"
   ]
