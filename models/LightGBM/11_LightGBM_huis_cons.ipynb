    "def voorspel(origins, blok=500):\n",
    "    preds = []\n",
    "    for i in range(0, len(origins), blok):\n",
    "        X_blok, _ = bouw_rijen(origins[i:i + blok])\n",
    "        preds.append(model.predict(X_blok, num_iteration=model.best_iteration).reshape(-1, horizon))\n",
    "    return np.vstack(preds)\n",
    "\n",
    "\n",
    "voorspel_gisteren = ev.seasonal_naive(huis_cons)\n",
    "\n",
    "\n",
    "def vergelijk(detail, detail_gisteren):\n",
    "    \"\"\"MAE en RMSE per horizon van LightGBM naast 'zelfde tijd gisteren'.\"\"\"\n",
    "    eigen, basis = ev.samenvatting(detail), ev.samenvatting(detail_gisteren)\n",
    "    return pd.DataFrame({\"aantal\": eigen[\"aantal\"],\n",
    "                         \"MAE LightGBM\": eigen[\"MAE\"],\n",
    "                         \"MAE zelfde tijd gisteren\": basis[\"MAE\"],\n",
    "                         \"RMSE LightGBM\": eigen[\"RMSE\"],\n",
    "                         \"RMSE zelfde tijd gisteren\": basis[\"RMSE\"]}).reindex(list(ev.HORIZONS)).round(1)\n",
    "\n",
    "\n",
    "detail_val = ev.rolling_evaluatie(voorspel, huis_cons, val_origins)\n",
    "detail_val_gisteren = ev.rolling_evaluatie(voorspel_gisteren, huis_cons, val_origins)\n",
    "\n",
    "print(f\"Validatie: {len(val_origins)} forecastmomenten\")\n",
    "vergelijk(detail_val, detail_val_gisteren)"
   ]
