    "def scores(pred, echt):\n",
    "    fout = pred - echt                               #NaN waar geen echte meting is\n",
    "    res = {\"MAE\": np.nanmean(np.abs(fout)), \"RMSE\": np.sqrt(np.nanmean(fout ** 2))}\n",
    "    for d in range(aantal_dagen_forecast):\n",
    "        s = slice(d * stap_per_dag, (d + 1) * stap_per_dag)\n",
    "        res[f\"MAE dag {d+1}\"] = np.nanmean(np.abs(fout[:, s]))\n",
    "    #Rolling validation: elke dag een nieuwe forecast\n",
    "    dagelijks = slice(None, None, stap_per_dag // stride_eval)\n",
    "    res[\"rolling MAE\"] = np.nanmean(np.nanmean(np.abs(fout[dagelijks]), axis=1))\n",
    "    res[\"rolling RMSE\"] = np.nanmean(np.sqrt(np.nanmean(fout[dagelijks] ** 2, axis=1)))\n",
    "    return res\n",
    "\n",
